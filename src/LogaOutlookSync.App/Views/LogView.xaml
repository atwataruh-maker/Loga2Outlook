<UserControl x:Class="LogaOutlookSync.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Protokoll" Style="{StaticResource HeaderTextStyle}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Information" IsChecked="{Binding ShowInfo}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <CheckBox Content="Warnung" IsChecked="{Binding ShowWarning}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <CheckBox Content="Fehler" IsChecked="{Binding ShowError}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="16,0,8,0" />
                <Button Content="Logordner öffnen" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogFolderCommand}" />
                <Button Content="Diagnosepaket exportieren" Style="{StaticResource SecondaryButton}" Command="{Binding ExportDiagnosticsCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,8,0,0" />
                <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="LogaOutlookSync.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4">
        <TextBlock Text="Dashboard" Style="{StaticResource HeaderTextStyle}" />

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Verbindungsstatus" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" FontWeight="SemiBold" />

                <TextBlock Text="Letzte Synchronisation" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding LastSyncTimeText}" />

                <TextBlock Text="Letzter Status" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding LastSyncStatusText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <UniformGrid Columns="2">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="Gefundene Urlaubseinträge" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding VacationEntriesFound}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="Gefundene Gleitzeiteinträge" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding FlexTimeEntriesFound}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Columns="3">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                <StackPanel>
                    <TextBlock Text="Angelegt" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Created}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0,6,12">
                <StackPanel>
                    <TextBlock Text="Aktualisiert" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Updated}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                <StackPanel>
                    <TextBlock Text="Gelöscht" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Deleted}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>

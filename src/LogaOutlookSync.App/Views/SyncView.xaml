<UserControl x:Class="LogaOutlookSync.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Synchronisation" Style="{StaticResource HeaderTextStyle}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Jetzt synchronisieren" Command="{Binding SyncNowCommand}" />
                    <Button Content="Vorschau" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewCommand}" />
                    <Button Content="Trockenlauf" Style="{StaticResource SecondaryButton}" Command="{Binding DryRunCommand}" />
                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource LabelTextStyle}" />
                <ProgressBar Height="6" IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Synchronisationsplan" Style="{StaticResource HeaderTextStyle}" FontSize="15" Margin="0,4,0,8" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding PlanItems}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Aktion" Binding="{Binding Operation}" Width="110" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="90" />
                    <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="180" />
                    <DataGridTextColumn Header="Zeitraum" Binding="{Binding DateRangeText}" Width="240" />
                    <DataGridTextColumn Header="Begründung" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
